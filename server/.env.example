# ============================================
# SkillVerse Server — Environment Variables
# Copy this file to .env and fill in the values
# ============================================

# ----------------------------
# SERVER
# ----------------------------

# Port the Express server listens on
PORT=5000

# ----------------------------
# DATABASE
# ----------------------------

# PostgreSQL connection string (Neon, Supabase, local, etc.)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ----------------------------
# AUTHENTICATION
# ----------------------------

# Secret used to sign/verify JWT tokens.
# Use a long, random string — min 32 characters recommended.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# ----------------------------
# AI — GROQ (primary, 14,400 req/day free)
# ----------------------------

# Get key at: https://console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# ----------------------------
# AI — GOOGLE GEMINI (fallback only)
# ----------------------------

# API key from https://aistudio.google.com/app/apikey
# Only used if Groq hits its rate limit
GEMINI_API_KEY=your_gemini_api_key_here
